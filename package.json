{
  "name": "ak820-pro-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun tsc -b && bun --bun vite build",
    "test": "bun test --pass-with-no-tests",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "test:browser": "bun --bun playwright test",
    "format": "bun --bun prettier --write src *.json *.ts *.md index.html"
  },
  "dependencies": {
    "gifuct-js": "2.1.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "^7.1.0"
  },
  "packageManager": "bun@1.4.2"
}
